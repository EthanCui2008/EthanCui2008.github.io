# Copy to keys/.env (gitignored), fill in real values, then run:
#   node keys/encode.mjs
# That bakes an obfuscated copy into keys/keys.js. keys/.env itself never deploys.
#
# Keep real values OUT of this example file — it is committed.
KEYS_NAME=Your Name
KEYS_PHONE=+1 (555) 010-0198
KEYS_ROOM=Building Unit 0A, Floor 0
